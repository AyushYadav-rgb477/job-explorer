# Copy this file to .env and fill in the values from
# Supabase Dashboard -> Project Settings -> API (and Data API for the URL).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Only needed on your own machine for scripts/seed_supabase.py. Never put this on Render.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string; signs the login cookie.
SECRET_KEY=change-me
